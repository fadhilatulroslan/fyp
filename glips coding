  message += "Camera — same Wi-Fi:\n" + cameraURL() + "\n";
  message += "Dashboard:\n" + dashboardURL() + "\n\n";
  message += "Measurement note: experimental gas estimate; not safety-calibrated.";
  return message;
}

void processTelegramAlerts() {
  unsigned long now = millis();
  if (sensorValid && currentState == STATE_SAFE && gasPPM <= GAS_SAFE_PPM) {
    if (!alertSafeTiming) { alertSafeTiming = true; alertSafeSince = now; }
    if (now - alertSafeSince >= ALERT_REARM_SAFE_MS && !alertCycleRearmed) {
      alertCycleRearmed = true;
      warningSent = false; dangerTextSent = false;
      warningLocationSent = false; dangerLocationSent = false;
      warningLocationAttempts = 0; dangerLocationAttempts = 0;
      photoPreparationAttempts = 0; lastPhotoPreparation = 0;
      if (!dangerPhotoAttempted || (photoStoreReady && photoStore.putBool("attempted", false) == 1)) dangerPhotoAttempted = false;
      dangerPhotoSent = false;
      warningTextAttempts = 0; dangerTextAttempts = 0;
      dangerEventTime = ""; lastAlert = 0;
      Serial.println("TELEGRAM: new incident enabled after 60 seconds SAFE");
    }
    return;
  }
  alertSafeTiming = false;
  alertCycleRearmed = false;
  if (!sensorValid || WiFi.status() != WL_CONNECTED) return;
  if (currentState == STATE_DANGER && dangerEventTime.length() == 0) dangerEventTime = getTimeText();
  bool canSend = lastAlert == 0 || now - lastAlert >= ALERT_RETRY;
  if (currentState == STATE_WARNING) {
    if (canSend && !warningSent && warningTextAttempts < ALERT_MAX_TEXT_ATTEMPTS) {
      lastAlert = now; ++warningTextAttempts;
      warningSent = sendTelegramText(buildTelegramAlert(false));
    }
    if (warningSent && !warningLocationSent && warningLocationAttempts < ALERT_MAX_TEXT_ATTEMPTS && (canSend || warningLocationAttempts == 0)) {
      lastAlert = now; ++warningLocationAttempts;
      warningLocationSent = sendTelegramLocation(TELEGRAM_SITE_LATITUDE, TELEGRAM_SITE_LONGITUDE);
    }
    return;
  }
  if (currentState != STATE_DANGER) return;
  if (canSend && !dangerTextSent && dangerTextAttempts < ALERT_MAX_TEXT_ATTEMPTS) {
    lastAlert = now; ++dangerTextAttempts;
    dangerTextSent = sendTelegramText(buildTelegramAlert(true));
  }
  if (dangerTextSent && !dangerLocationSent && dangerLocationAttempts < ALERT_MAX_TEXT_ATTEMPTS && (canSend || dangerLocationAttempts == 0)) {
    lastAlert = now; ++dangerLocationAttempts;
    dangerLocationSent = sendTelegramLocation(TELEGRAM_SITE_LATITUDE, TELEGRAM_SITE_LONGITUDE);
  }
  // Photo is independent of pin acknowledgement, so a pin failure cannot hide it.
  if (!dangerPhotoAttempted && photoPreparationAttempts < 3 && (lastPhotoPreparation == 0 || now - lastPhotoPreparation >= ALERT_RETRY)) {
    lastPhotoPreparation = now; ++photoPreparationAttempts;
    if (!cameraReady) {
      Serial.println("TELEGRAM PHOTO: camera unavailable - see CAMERA INIT log");
      return;
    }
    String caption = "GLiPS | IKM Lumut\nDANGER incident snapshot\n" + dangerEventTime;
    caption += "\nGas estimate: " + String(gasPPM, 1) + " ppm (experimental)";
    dangerPhotoSent = sendTelegramPhoto(caption);
    Serial.println(dangerPhotoSent ? "TELEGRAM PHOTO: sent" : dangerPhotoAttempted ? "TELEGRAM PHOTO: upload started but delivery not confirmed; no duplicate retry" : "TELEGRAM PHOTO: preparation failed; limited retry available");
  }
}

void updateSystemState() {
  if (!sensorValid) return;
  AlertState newState = currentState;

  if (gasPPM >= GAS_DANGER_PPM) newState = STATE_DANGER;
  else if (gasPPM > GAS_WARNING_PPM) newState = STATE_WARNING;
  else if (gasPPM <= GAS_SAFE_PPM) newState = STATE_SAFE;

  if (newState != currentState) {
    currentState = newState;
    if (currentState == STATE_DANGER) lastAlert = 0;
    updateOutputs();
    updateLCD();
    if (currentState == STATE_WARNING || currentState == STATE_DANGER) playAlarm();
    else stopAlarm();
  }
}

