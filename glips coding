// ==========================================
// MQ5 REAL ADC + NON-BLOCKING CLEAN-AIR BASELINE
// ==========================================
MQ5Reading readMQ5() {
  uint32_t adcSum = 0, mvSum = 0;
  for (unsigned int i = 0; i < MQ5_SAMPLES; ++i) {
    adcSum += analogRead(MQ5_PIN);
    mvSum += analogReadMilliVolts(MQ5_PIN);
    yield();
  }
  MQ5Reading r;
  r.adc = adcSum / float(MQ5_SAMPLES);
  r.gpioVoltage = mvSum / float(MQ5_SAMPLES) / 1000.0f;
  r.aoVoltage = r.gpioVoltage * DIVIDER_GAIN;
  r.rs = NAN;
  if (r.aoVoltage > 0 && r.aoVoltage < MQ5_VCC && r.adc > 10 && r.adc < 4000)
    r.rs = MQ5_RL * (MQ5_VCC - r.aoVoltage) / r.aoVoltage;
  return r;
}

void restoreMQ5Baseline() {
  if (!mq5Store.begin("glips-mq5", false)) {
    Serial.println("MQ5 NVS unavailable"); return;
  }
  R0 = mq5Store.getFloat("r0-estimate", NAN);
  if (isfinite(R0) && R0 > 0) Serial.printf("MQ5 R0 restored: %.4f kOhm\n", R0);
  else Serial.println("MQ5 BASELINE NEEDED: warm sensor in clean air, then send CALIBRATE_MQ5");
}

void startMQ5Calibration() {
  if (mq5Calibrating) return;
  if (sensorValid && currentState != STATE_SAFE) {
    Serial.println("MQ5 calibration rejected: elevated reading"); return;
  }
  mq5Calibrating = true;
  mq5CalSamples = mq5CalValid = 0;
  mq5CalSum = 0;
  mq5CalLast = millis() - 1000;
  Serial.println("MQ5: collecting 60 clean-air samples; no certified PPM accuracy");
}

void serviceMQ5Calibration() {
  if (!mq5Calibrating || millis() - mq5CalLast < 1000) return;
  mq5CalLast = millis();
  MQ5Reading r = readMQ5();
  ++mq5CalSamples;
  if (isfinite(r.rs) && r.rs > 0) { mq5CalSum += r.rs; ++mq5CalValid; }
  if (mq5CalSamples % 10 == 0)
    Serial.printf("MQ5 baseline: %u/60, valid=%u\n", mq5CalSamples, mq5CalValid);
  if (mq5CalSamples < 60) return;
  mq5Calibrating = false;
  if (mq5CalValid < 50) {
    Serial.println("MQ5 BASELINE FAILED: check ADC saturation, AO voltage and divider"); return;
  }
  float candidate = (mq5CalSum / mq5CalValid) / CLEAN_AIR_RATIO;
  if (!isfinite(candidate) || candidate <= 0) return;
  R0 = candidate;
  mq5Store.putFloat("r0-estimate", R0);
  Serial.printf("MQ5 experimental R0: %.4f kOhm\n", R0);
}

float readLPGppm() {
  lastMQ5 = readMQ5();
  if (!isfinite(R0) || R0 <= 0 || !isfinite(lastMQ5.rs) || lastMQ5.rs <= 0) return NAN;
  float ppm = LPG_A * powf(lastMQ5.rs / R0, LPG_B);
  return isfinite(ppm) && ppm >= 0 ? ppm : NAN;
}

